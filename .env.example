# =============================================================================
# .env.example – Environment variable template
# AI-Powered E-Commerce DevOps & Cloud-Native Delivery Platform
# Copy to .env and fill in real values. DO NOT commit .env to Git.
# =============================================================================

# ── Application ───────────────────────────────────────────────
NODE_ENV=production
FRONTEND_PORT=3000
BACKEND_PORT=5000
JWT_SECRET=CHANGE_ME_STRONG_SECRET

# ── Database ──────────────────────────────────────────────────
DB_HOST=db
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_URL=postgresql://postgres:CHANGE_ME_DB_PASSWORD@db:5432/ecommerce

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── Monitoring ────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# ── AI Analysis ───────────────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME_OPENAI_API_KEY
AI_MODEL=gpt-4o-mini

# ── Docker Registry ───────────────────────────────────────────
REGISTRY=docker.io
REGISTRY_REPO=davine-ecommerce
IMAGE_NAME=ecommerce-app

# ── Cloud / AWS ───────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=CHANGE_ME_ACCOUNT_ID
