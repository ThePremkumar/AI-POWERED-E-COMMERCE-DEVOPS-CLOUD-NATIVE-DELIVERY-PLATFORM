// =============================================================================
// Jenkinsfile – Simple CI/CD Pipeline
// AI-Powered E-Commerce DevOps & Cloud-Native Delivery Platform
// =============================================================================

pipeline {
    agent any

    environment {
        // Docker Hub settings
        REGISTRY           = "docker.io"
        REGISTRY_REPO      = "thepremkumar/ai-ecommerce"
        IMAGE_NAME         = "${REGISTRY}/${REGISTRY_REPO}"
        IMAGE_TAG          = "${BUILD_NUMBER}"

        // Kubernetes / Helm settings
        K8S_NAMESPACE      = "ecommerce"
        HELM_RELEASE       = "ecommerce-app"
        HELM_CHART         = "./helm/ecommerce"

        // Jenkins credential ID
        DOCKER_CREDENTIALS = "dockerhub-creds"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10"))
        timeout(time: 30, unit: "MINUTES")
        timestamps()
    }

    stages {

        // 1. Checkout Code
        stage("Checkout") {
            steps {
                checkout scm
                sh 'echo "Building Jenkins build #${BUILD_NUMBER}"'
            }
        }

        // 2. Build & Test Node.js App
        stage("Build & Test") {
            steps {
                sh '''
                    if [ -f app/package.json ]; then
                        npm ci --prefix app/
                        npm test --prefix app/
                    else
                        echo "No app/package.json found; skipping Node.js tests."
                    fi
                '''
            }
        }

        // 3. Build Docker Image
        stage("Docker Build") {
            steps {
                script {
                    def img = docker.build(
                        "${IMAGE_NAME}:${IMAGE_TAG}",
                        "-f docker/Dockerfile ."
                    )
                    img.tag("latest")
                }
            }
        }

        // 4. Push Image to Docker Hub
        stage("Docker Push") {
            steps {
                script {
                    docker.withRegistry(
                        "https://${REGISTRY}",
                        DOCKER_CREDENTIALS
                    ) {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                        docker.image("${IMAGE_NAME}:latest").push()
                    }
                }
            }
        }

        // 5. Deploy to Kubernetes using Helm
        stage("Deploy to Kubernetes") {
            steps {
                sh '''
                    helm upgrade --install "$HELM_RELEASE" "$HELM_CHART" \
                        --namespace "$K8S_NAMESPACE" \
                        --create-namespace \
                        --set-string image.tag="$IMAGE_TAG" \
                        --set-string image.repository="$IMAGE_NAME"
                '''
            }
        }

        // 6. Verify Rollout
        stage("Verify Rollout") {
            steps {
                sh '''
                    kubectl rollout status \
                        deployment/"$HELM_RELEASE" \
                        -n "$K8S_NAMESPACE" \
                        --timeout=120s
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment successful! Image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline failed at build #${BUILD_NUMBER}."
        }
        always {
            echo "Pipeline execution completed."
        }
    }
}