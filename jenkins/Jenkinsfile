// =============================================================================
// Jenkinsfile – Simple CI/CD Pipeline
// AI-Powered E-Commerce DevOps & Cloud-Native Delivery Platform
// =============================================================================

pipeline {
    agent any

    environment {
        // Registry settings
        REGISTRY          = "docker.io"
        IMAGE_NAME        = "thepremkumar/ecommerce-app"
        IMAGE_TAG         = "${env.BUILD_NUMBER}"

        // Kubernetes / Helm settings
        K8S_NAMESPACE     = "ecommerce"
        K8S_CONTEXT       = "kind-k8s"
        HELM_RELEASE      = "ecommerce-app"
        HELM_CHART        = "./helm/ecommerce"

        // Credentials
        DOCKER_CREDENTIALS = "dockerhub-creds"
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10"))
        timeout(time: 30, unit: "MINUTES")
        timestamps()
    }

    stages {
        // 1. Checkout Code
        stage("Checkout") {
            steps {
                checkout scm
                sh "echo 'Building #${env.BUILD_NUMBER} on ${env.BRANCH_NAME ?: 'main'}'"
            }
        }

        // 2. Build & Test Node.js App
        stage("Build & Test") {
            steps {
                sh """
                    if [ -f app/package.json ]; then
                        npm ci --prefix app/ 2>/dev/null || true
                        npm test --prefix app/ 2>/dev/null || true
                    fi
                """
            }
        }

        // 3. Build Docker Image
        stage("Docker Build") {
            steps {
                sh """
                    docker build -t ${IMAGE_NAME}:${IMAGE_TAG} -f docker/Dockerfile .
                    docker tag ${IMAGE_NAME}:${IMAGE_TAG} ${IMAGE_NAME}:latest
                """
            }
        }

        // 4. Push Image to Docker Hub
        // Uses withCredentials to login/logout cleanly — avoids Jenkins Docker
        // plugin registry-URL quirks that cause silent push failures.
        stage("Docker Push") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKER_CREDENTIALS,
                    usernameVariable: "DH_USER",
                    passwordVariable: "DH_PASS"
                )]) {
                    sh """
                        echo "${DH_PASS}" | docker login ${REGISTRY} -u "${DH_USER}" --password-stdin
                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                        docker push ${IMAGE_NAME}:latest
                        docker logout ${REGISTRY}
                    """
                }
            }
        }

        // 5. Deploy to Local Kubernetes (KinD) via Helm
        // --kube-context is passed explicitly so every sh step uses the right cluster.
        stage("Deploy to Kubernetes") {
            steps {
                sh """
                    helm upgrade --install ${HELM_RELEASE} ${HELM_CHART} \
                        --kube-context ${K8S_CONTEXT} \
                        --namespace ${K8S_NAMESPACE} \
                        --create-namespace \
                        --set image.repository=${REGISTRY}/${IMAGE_NAME} \
                        --set image.tag=${IMAGE_TAG} \
                        --set image.pullPolicy=Always \
                        --wait --timeout=3m
                """
            }
        }

        // 6. Verify Rollout
        stage("Verify Rollout") {
            steps {
                sh """
                    kubectl --context ${K8S_CONTEXT} rollout status deployment/${HELM_RELEASE} \
                        -n ${K8S_NAMESPACE} --timeout=120s
                """
            }
        }
    }

    post {
        success {
            echo "✅ Deployment successful! Image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "❌ Pipeline failed at build #${env.BUILD_NUMBER}."
        }
        always {
            // Clean up dangling images to save disk space
            sh "docker image prune -f || true"
        }
    }
}
