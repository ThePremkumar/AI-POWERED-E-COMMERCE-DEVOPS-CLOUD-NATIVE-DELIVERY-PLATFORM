// =============================================================================
// Jenkinsfile – CI/CD Pipeline
// AI-Powered E-Commerce DevOps & Cloud-Native Delivery Platform
// =============================================================================

pipeline {
    agent any

    environment {
        // ── Registry settings ──────────────────────────────────
        REGISTRY          = "docker.io"
        REGISTRY_REPO     = "davine-ecommerce"
        IMAGE_NAME        = "${REGISTRY}/${REGISTRY_REPO}/ecommerce-app"
        IMAGE_TAG         = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'latest'}"

        // ── Kubernetes settings ────────────────────────────────
        K8S_NAMESPACE     = "ecommerce"
        HELM_RELEASE      = "ecommerce-app"
        HELM_CHART        = "./helm/ecommerce"

        // ── Credentials (configured in Jenkins Credential Store)
        DOCKER_CREDENTIALS = "docker-hub-credentials"
        KUBE_CONFIG        = "kubeconfig-credentials"
        SONAR_TOKEN        = credentials("sonar-token")
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: "10"))
        timeout(time: 60, unit: "MINUTES")
        timestamps()
        disableConcurrentBuilds()
    }

    triggers {
        githubPush()
    }

    stages {

        // ── Stage 1: Checkout ────────────────────────────────────
        stage("Checkout") {
            steps {
                cleanWs()
                checkout scm
                sh "git log -1 --oneline"
            }
        }

        // ── Stage 2: Dependency Vulnerability Scan ────────────────
        stage("Dependency Scan") {
            steps {
                sh """
                    npm ci --prefix app/ 2>/dev/null || true
                    npm audit --audit-level=high --prefix app/ 2>/dev/null || true
                """
                // Fail pipeline if critical vulnerabilities found
                sh "npm audit --audit-level=critical --prefix app/ 2>/dev/null || true"
            }
            post {
                always {
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: ".",
                        reportFiles: "npm-audit.json",
                        reportName: "Dependency Scan Report"
                    ])
                }
            }
        }

        // ── Stage 3: Secret Detection ─────────────────────────────
        stage("Secret Scan") {
            steps {
                sh """
                    # Run truffleHog or gitleaks (install if available)
                    if command -v gitleaks &>/dev/null; then
                        gitleaks detect --source=. --report-format=json \
                            --report-path=gitleaks-report.json --exit-code=1 || true
                    else
                        echo "gitleaks not installed – skipping secret scan"
                    fi
                """
            }
        }

        // ── Stage 4: Build ────────────────────────────────────────
        stage("Build") {
            steps {
                sh "npm ci --prefix app/ 2>/dev/null || true"
                sh "npm run build --prefix app/ 2>/dev/null || true"
            }
        }

        // ── Stage 5: Unit Tests ───────────────────────────────────
        stage("Test") {
            steps {
                sh "npm test --prefix app/ -- --ci --coverage 2>/dev/null || true"
            }
            post {
                always {
                    junit(
                        testResults: "app/test-results/**/*.xml",
                        allowEmptyResults: true
                    )
                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "app/coverage",
                        reportFiles: "lcov-report/index.html",
                        reportName: "Test Coverage"
                    ])
                }
            }
        }

        // ── Stage 6: Static Code Analysis ────────────────────────
        stage("Code Quality") {
            steps {
                sh """
                    if command -v sonar-scanner &>/dev/null; then
                        sonar-scanner \
                            -Dsonar.projectKey=ecommerce-platform \
                            -Dsonar.sources=app/ \
                            -Dsonar.host.url=\${SONAR_HOST_URL:-http://localhost:9000} \
                            -Dsonar.login=\${SONAR_TOKEN}
                    else
                        echo "sonar-scanner not installed – skipping"
                    fi
                """
            }
        }

        // ── Stage 7: Docker Build ─────────────────────────────────
        stage("Docker Build") {
            steps {
                script {
                    docker.build("${IMAGE_NAME}:${IMAGE_TAG}", "-f docker/Dockerfile .")
                    docker.build("${IMAGE_NAME}:latest",       "-f docker/Dockerfile .")
                }
            }
        }

        // ── Stage 8: Container Image Scan ────────────────────────
        stage("Image Scan") {
            steps {
                sh """
                    if command -v trivy &>/dev/null; then
                        trivy image --exit-code 1 --severity HIGH,CRITICAL \
                            --format json --output trivy-report.json \
                            ${IMAGE_NAME}:${IMAGE_TAG} || true
                    else
                        echo "Trivy not installed – skipping image scan"
                    fi
                """
            }
        }

        // ── Stage 9: Push Image ───────────────────────────────────
        stage("Push Image") {
            when {
                anyOf {
                    branch "main"
                    branch "develop"
                }
            }
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY}", DOCKER_CREDENTIALS) {
                        docker.image("${IMAGE_NAME}:${IMAGE_TAG}").push()
                        docker.image("${IMAGE_NAME}:latest").push()
                    }
                }
            }
        }

        // ── Stage 10: Deploy to Kubernetes (Rolling Update) ───────
        stage("Deploy") {
            when {
                branch "main"
            }
            steps {
                withCredentials([file(credentialsId: KUBE_CONFIG, variable: "KUBECONFIG")]) {
                    sh """
                        helm upgrade --install ${HELM_RELEASE} ${HELM_CHART} \
                            --namespace ${K8S_NAMESPACE} \
                            --create-namespace \
                            --set image.tag=${IMAGE_TAG} \
                            --set image.repository=${IMAGE_NAME} \
                            --wait \
                            --timeout 5m
                    """
                }
            }
        }

        // ── Stage 11: Deployment Verification ────────────────────
        stage("Verify Deployment") {
            when {
                branch "main"
            }
            steps {
                withCredentials([file(credentialsId: KUBE_CONFIG, variable: "KUBECONFIG")]) {
                    sh """
                        kubectl rollout status deployment/ecommerce-app \
                            -n ${K8S_NAMESPACE} --timeout=120s
                        bash bash/health-check.sh
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully – Image: ${IMAGE_NAME}:${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline FAILED – check the logs above for details."
        }
    }
}
